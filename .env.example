GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=20000

# device/rules/schedule-tasks/alarms/db-query/rag 클라이언트가 실제로 쓰는 백엔드 주소.
WAVEHOME_AGENT_INTERNAL_BASE_URL=http://127.0.0.1:8500/internal/v1
WAVEHOME_CORE_API_TIMEOUT_MS=5000
WAVEHOME_CORE_API_MOCK=true # false로 변경해서 backend 서버를 실제로 호출하도록 테스트 가능

# device-tool-api.md 카메라 stream 응답(GET/PUT .../stream)의 mock 모드 placeholder url.
# 실제 백엔드(WAVEHOME_CORE_API_MOCK=false)에서는 무시되고 백엔드가 내려주는 url을 그대로 씀.
MOCK_CAMERA_STREAM_URL=mock://stream

# docs/api.md §1.3 /llm/v1/* 프록시가 포워딩할 Ollama 서버 주소 (OpenAI 호환 /v1/* 필요).
# 실제 팀 공유 주소는 .env에만 넣고 커밋하지 마세요.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=30000

# /sleep/v1, /power/v1 job 응답의 기본 임베딩 모델(vec_* 스키마와 차원 일치 필요, 768차원).
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
